{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kylephernandez/pointview/schemas/laptop_message.schema.json",
  "title": "PointView laptop \u2192 phone message",
  "description": "Sent by the laptop on the same WebSocket. See docs/phone-protocol.md.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "style"
      ],
      "properties": {
        "type": {
          "const": "haptic"
        },
        "style": {
          "enum": [
            "snap",
            "select",
            "align_ok",
            "error"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "aligned",
        "selected"
      ],
      "properties": {
        "type": {
          "const": "status"
        },
        "aligned": {
          "type": "boolean"
        },
        "selected": {
          "type": [
            "string",
            "null"
          ],
          "description": "Label of the snapped item, if any."
        },
        "fps": {
          "type": "number",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "look": {
          "enum": [
            "normal",
            "crt",
            "nvg",
            "flir",
            "noir",
            "snow"
          ]
        },
        "passthrough": {
          "type": "boolean"
        },
        "marker": {
          "enum": [
            "point",
            "square"
          ]
        },
        "tracking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "dictionary",
            "marker_id",
            "cells",
            "state"
          ],
          "properties": {
            "session": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "dictionary": {
              "const": "DICT_6X6_1000"
            },
            "marker_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "cells": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[01]{8}$"
              }
            },
            "state": {
              "enum": [
                "off",
                "searching",
                "verifying",
                "tracked",
                "coasting"
              ]
            }
          }
        }
      }
    }
  ]
}
